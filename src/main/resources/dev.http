GET localhost:7070/api/routes

### Create user
POST http://localhost:7070/api/auth/register

{
    "username": "admin",
    "password": "test123"
}
### Login
POST http://localhost:7070/api/auth/login

{
    "username": "admin",
    "password": "test123"
}
> {%
    client.global.set("token", response.body.token);
    client.log("Logging Bearer Token.");
    client.log("Bearer " + response.body.token);
    client.log("Username: " + response.body.username);
%}

### Populate data
POST localhost:7070/api/skilessons/populate
Authorization: Bearer {{token}}

### Get all skilessons
GET localhost:7070/api/skilessons
Authorization: Bearer {{token}}

### Get skiLesson by ID
GET localhost:7070/api/skilessons/3?includeInstructions=true
Authorization: Bearer {{token}}

### Create new skiLesson
POST localhost:7070/api/skilessons
Authorization: Bearer {{token}}
Content-Type: "application/json"

{
    "name": "Trip to Bilka",
    "price": 802.50,
    "level": "BEGINNER",
    "startTime": "14:30",
    "endTime": "15:45",
    "location": {
        "description": "Bilka",
        "latitude": 55.123456,
        "longitude": 10.123456
    }
}

### Add instructor to skiLesson
PUT localhost:7070/api/skilessons/6/instructors/1

### Update skiLesson
PUT localhost:7070/api/skilessons/6
Authorization: Bearer {{token}}
Content-Type: "application/json"

{
    "name": "Trip to the Old City"
}

### Delete skiLesson
DELETE localhost:7070/api/skilessons/1
Authorization: Bearer {{token}}

### Get skilesson filtered by level
GET localhost:7070/api/skilessons/level/adVancEd
Authorization: Bearer {{token}}

### Get lessons offered by instructor
GET localhost:7070/api/instructors/1/skilessons
Authorization: Bearer {{token}}

### Get total sum price of lessons offered by instructors
GET localhost:7070/api/instructors/totalsumprice
Authorization: Bearer {{token}}

### Get total sum duration of lessons offered by instructors
GET localhost:7070/api/instructors/totalsumduration
Authorization: Bearer {{token}}

### Get skiLesson with Items
GET localhost:7070/api/skilessons/1/?withItems=true